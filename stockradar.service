[Unit]
Description=StockRadar Pro Trading Bot
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/AcilPiyasaBotu
ExecStart=/usr/bin/python3 /home/pi/AcilPiyasaBotu/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/pi/AcilPiyasaBotu/stockradar.log
StandardError=append:/home/pi/AcilPiyasaBotu/stockradar.log

# Environment
Environment="PYTHONUNBUFFERED=1"

# Güvenlik ayarları
Nice=0
CPUQuota=80%

[Install]
WantedBy=multi-user.target
