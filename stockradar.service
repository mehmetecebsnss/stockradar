[Unit]
Description=StockRadar Pro Trading Bot
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/stockradar
ExecStart=/home/pi/stockradar/venv/bin/python3 /home/pi/stockradar/bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/pi/stockradar/stockradar.log
StandardError=append:/home/pi/stockradar/stockradar.log
Environment="PYTHONUNBUFFERED=1"
Nice=0

[Install]
WantedBy=multi-user.target
